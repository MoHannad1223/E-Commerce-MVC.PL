        }
        .service-icon {
            background: #e94560 !important;
            color: #fff !important;
            border-radius: 50%;
            border: 2px solid #fff;
            transition: background 0.2s, color 0.2s;
        }
        .service-card:hover .service-icon {
            background: #fff !important;
            color: #111 !important;
            border: 2px solid #e94560;
        }
        .service-card:hover .service-icon i {
            color: #111 !important;
        }
        .service-title {
            color: #e94560;
            font-weight: bold;
            transition: color 0.2s;
        }

        /* Slider Styles */
        .slide {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.5s ease-in-out;
            display: none;
        }
        .slide.active {
            opacity: 1;
            display: flex;
        }
        .slider-dots {
            display: flex;
            gap: 8px;
        }
        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.5);
            cursor: pointer;
            transition: background 0.3s;
        }
        .dot.active {
            background: #fff;
        }
        .banner-link {
            display: inline-block;
            padding: 8px 0;
            color: #fff !important;
            text-decoration: none;
            position: relative;
            transition: all 0.3s;
        }
        .banner-link::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: #e94560;
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.3s ease;
        }
        .banner-link:hover {
            color: #e94560 !important;
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

@section Scripts {
    <script>
        // Simple JS slider
        const slides = document.querySelectorAll('.slide');
        const dots = document.querySelectorAll('.slider-dots .dot');
        let currentSlide = 0;

        function showSlide(idx) {
            slides.forEach((slide, i) => {
                slide.classList.toggle('active', i === idx);
                dots[i].classList.toggle('active', i === idx);
            });
            currentSlide = idx;
        }

        dots.forEach((dot, i) => {
            dot.addEventListener('click', () => showSlide(i));
        });

        // Auto-slide every 5 seconds
        setInterval(() => {
            let next = (currentSlide + 1) % slides.length;
            showSlide(next);
        }, 5000);

        // Initialize
        showSlide(0);

        // Flash cards scroll
        document.addEventListener('DOMContentLoaded', function() {
            const flashCardsRow = document.getElementById('flashCardsRow');
            const leftArrow = document.querySelector('.cat-arrow.me-2');
            const rightArrow = document.querySelector('.cat-arrow:not(.me-2)');

            leftArrow.addEventListener('click', function() {
                flashCardsRow.scrollTo({
                    left: flashCardsRow.scrollLeft - 240,
                    behavior: 'smooth'
                });
            });

            rightArrow.addEventListener('click', function() {
                flashCardsRow.scrollTo({
                    left: flashCardsRow.scrollLeft + 240,
                    behavior: 'smooth'
                });
            });
        });
    </script>
}
